<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- Properties for compiling an android build of P:FAN -->
	<!-- ADD <include path="android.xml" if="android" /> IN THE PROJECT.XML TO USE THIS -->

	<haxelib name="extension-androidtools" version="2.2.2" if="android" />
	<!-- Compile 64-bit only, idk if 32-bit works -->
	<architecture name="arm64" exclude="armv7" if="android" />
	<android target-sdk-version="35" />
	<android minimum-sdk-version="28" />
	<!-- Keystore from MobilePorting port of Psych Engine -->
	<certificate path="key.keystore" password="psychengine" alias="psychport" alias-password="psychengine" if="android" unless="debug" />

	<!-- Permissions for the mod's external directory -->
	<config:android permission="android.permission.ACCESS_MEDIA_LOCATION" />
    <config:android permission="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <config:android permission="android.permission.READ_MEDIA_IMAGES" />
    <config:android permission="android.permission.READ_MEDIA_VIDEO" />
    <config:android permission="android.permission.READ_MEDIA_AUDIO" />
    <config:android permission="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <config:android permission="android.permission.READ_EXTERNAL_STORAGE" />
    <config:android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
    <config:android permission="android.permission.READ_PHONE_STATE" />

	<!-- Allows extending into the display cutout -->
    <config:android layoutInDisplayCutoutMode="shortEdges" if="${lime >= 8.3.0}" />

    <config:android>
        <application android:requestLegacyExternalStorage="true" />
        <application android:preserveLegacyExternalStorage="true" />
        <application android:largeHeap="true" />
        <application android:icon="@drawable/icon" />
        <application android:theme="@style/LimeAppMainTheme" />
        <gradle-properties org.gradle.jvmargs='-Xmx4G' />
    </config:android>

	<!-- Templates to enable some stuff -->
	<section if="android">
		<template path="templates/android/app/build.gradle" rename="app/build.gradle" />
		<template path="templates/android/app/src/main/res/values/themes.xml" rename="app/src/main/res/values/themes.xml" />
		<template path="templates/android/app/src/main/res/drawable-ldpi/icon16.png" rename="app/src/main/res/drawable-ldpi/icon16.png" />
		<template path="templates/android/app/src/main/res/drawable-mdpi/icon32.png" rename="app/src/main/res/drawable-mdpi/icon32.png" />
		<template path="templates/android/app/src/main/res/drawable-hdpi/icon64.png" rename="app/src/main/res/drawable-hdpi/icon64.png" />
		<template path="templates/android/app/src/main/res/drawable-xhdpi/icon.png" rename="app/src/main/res/drawable-xhdpi/icon.png" />
	</section>

	<!--
		ignore this. this is for me only, i specifically need this to compile
		compiling with termux is so tuff
		- melodiekit
	-->
	<section if="android TERMUX_COMPILE">
		<setenv name="ANDROID_GRADLE_TASK" value="assembleRelease --stacktrace" />
		<gradle-properties android.aapt2FromMavenOverride='/data/data/com.termux/files/home/aapt2/aapt2' />
	</section>
</project>
